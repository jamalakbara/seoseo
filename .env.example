# ---------------------------------------------------------------------------
# SeoSeo configuration. Copy to `.env` and edit.
# Everything works without paid API keys.
# ---------------------------------------------------------------------------

# Database password (required). Generate one: openssl rand -base64 24
POSTGRES_PASSWORD=change-me

# Public URL of the web app.
WEB_BASE_URL=http://localhost:3000

# Where the web app listens on the host. Use 0.0.0.0 to expose it on your network
# (put it behind HTTPS first and set COOKIE_SECURE=true).
WEB_BIND=127.0.0.1
WEB_PORT=3000
COOKIE_SECURE=false

# password: email + password accounts; the first visitor creates the admin account.
# none:     no sign-in, everyone is admin. ONLY on a trusted private network.
AUTH_MODE=password

# Allow new sign-ups after the admin account exists (otherwise invite-only).
ALLOW_SIGNUP=false

# Background job concurrency.
WORKER_CONCURRENCY=8

# --- Data providers --------------------------------------------------------
# Keyword ideas, Wikipedia demand signals and domain authority work out of the box.

# Encrypts API keys you add under Settings -> Data providers (optional providers
# such as Brave or Serper). Generate: openssl rand -base64 32
# Keep it stable: changing it makes stored keys unreadable.
APP_ENCRYPTION_KEY=

# Free search results for SERP analysis and keyword difficulty: start the bundled
# SearXNG with `--profile serp` and uncomment the next two lines.
#SEARXNG_URL=http://searxng:8080
#SEARXNG_SECRET=change-me

RUST_LOG=info

# Optional browser audits: start with --profile renderer.
RENDERER_URL=
# Set to http://renderer:8080 when the renderer profile is enabled.

# Google Search Console (free). Also requires APP_ENCRYPTION_KEY above.
# Enable Search Console API in Google Cloud and create a Web application OAuth client.
# Authorized redirect: <WEB_BASE_URL>/api/v1/gsc/oauth/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional onboarding model (local Ollama example: http://host.docker.internal:11434/v1).
# Models run only when a user or agent explicitly requests a draft.
OPENAI_COMPAT_BASE_URL=
OPENAI_COMPAT_API_KEY=
LLM_MODEL=
# Approved compatible model IDs, comma-separated (up to 10); empty falls back to LLM_MODEL.
# AI visibility trackers choose up to 3. Configure the API and worker identically.
AI_VISIBILITY_MODELS=
# Native engines: IDs appear as ollama/<model>, anthropic/<model>, gemini/<model>.
# Install local models separately; cloud keys/models are optional BYOK.
# Anthropic requests web search; Gemini uses standard text generation without Search grounding.
AI_OLLAMA_URL=http://ollama:11434/v1
AI_OLLAMA_MODELS=
AI_ANTHROPIC_MODEL=
AI_ANTHROPIC_API_KEY=
AI_GEMINI_MODEL=
AI_GEMINI_API_KEY=
